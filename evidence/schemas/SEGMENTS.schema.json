{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/navier-stokes-everyday/SEGMENTS.schema.json",
  "title": "Everyday English range segment record",
  "description": "One provenance record for one live EESegment target block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "status",
    "pdf_pages",
    "source",
    "target",
    "relation",
    "mathematical_content",
    "decoding_burdens",
    "consequential_choices",
    "discourse_job",
    "predicted_comprehension_mechanism",
    "academic_register_knowledge_removed",
    "retained_technical_terms",
    "risks",
    "checks_performed",
    "alternatives_considered",
    "same_meaning",
    "checks",
    "supersession"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/recordId" },
    "record_type": { "const": "segment" },
    "status": { "$ref": "#/$defs/status" },
    "pdf_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pdfPage" }
    },
    "source": { "$ref": "#/$defs/sourceSpan" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "target_id", "body_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "target_id": { "$ref": "#/$defs/targetSegmentId" },
        "body_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "linked_source_ids", "linked_target_ids"],
      "properties": {
        "kind": { "enum": ["translated", "retained", "split", "merged"] },
        "linked_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "linked_target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetSegmentId" }
        }
      }
    },
    "mathematical_content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "kind", "exact_content", "authority"],
        "properties": {
          "content_id": { "$ref": "#/$defs/recordId" },
          "kind": { "enum": ["claim", "definition", "formula", "dependency", "notation", "none"] },
          "exact_content": { "$ref": "#/$defs/nonemptyString" },
          "authority": { "$ref": "#/$defs/nonemptyString" }
        }
      }
    },
    "decoding_burdens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "consequential_choices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consequentialChoice" }
    },
    "discourse_job": { "$ref": "#/$defs/nonemptyString" },
    "predicted_comprehension_mechanism": { "$ref": "#/$defs/nonemptyString" },
    "academic_register_knowledge_removed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "retained_technical_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "first_use_explanation_available", "first_use_candidate_id", "explanation_addition_id"],
        "properties": {
          "term": { "$ref": "#/$defs/nonemptyString" },
          "first_use_explanation_available": { "type": "boolean" },
          "first_use_candidate_id": { "type": ["string", "null"] },
          "explanation_addition_id": {
            "oneOf": [
              { "$ref": "#/$defs/additionId" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "control"],
        "properties": {
          "risk": { "$ref": "#/$defs/nonemptyString" },
          "control": { "$ref": "#/$defs/nonemptyString" }
        }
      }
    },
    "checks_performed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "outcome", "evidence"],
        "properties": {
          "check": { "$ref": "#/$defs/nonemptyString" },
          "outcome": { "enum": ["pass", "pending", "fail", "not_applicable"] },
          "evidence": { "$ref": "#/$defs/nonemptyString" }
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alternative", "rejection_reason"],
        "properties": {
          "alternative": { "$ref": "#/$defs/nonemptyString" },
          "rejection_reason": { "$ref": "#/$defs/nonemptyString" }
        }
      }
    },
    "same_meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_to_target", "target_to_source"],
      "properties": {
        "source_to_target": { "$ref": "#/$defs/requiredCheck" },
        "target_to_source": { "$ref": "#/$defs/requiredCheck" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notation", "definition", "formula", "cross_reference", "proof_dependency"],
      "properties": {
        "notation": { "$ref": "#/$defs/check" },
        "definition": { "$ref": "#/$defs/check" },
        "formula": { "$ref": "#/$defs/check" },
        "cross_reference": { "$ref": "#/$defs/check" },
        "proof_dependency": { "$ref": "#/$defs/check" }
      }
    },
    "supersession": { "$ref": "#/$defs/supersession" }
  },
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "recordId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "targetSegmentId": { "type": "string", "pattern": "^EE-TGT-P[0-9]{3}-[0-9]{3}$" },
    "additionId": { "type": "string", "pattern": "^EE-ADD-P[0-9]{3}-[0-9]{3}$" },
    "status": { "enum": ["pass", "pending", "fail", "superseded"] },
    "pdfPage": { "type": "integer", "minimum": 1, "maximum": 166 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "line_start", "line_end", "span_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "span_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "canonSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "supports", "why_fit", "evidence_limits"],
      "properties": {
        "passage_id": { "type": "string", "pattern": "^EE-[0-9]{3}$" },
        "supports": { "$ref": "#/$defs/nonemptyString" },
        "why_fit": { "$ref": "#/$defs/nonemptyString" },
        "evidence_limits": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "consequentialChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_id", "source_wording", "target_wording", "consequence", "canon_support", "canon_gap"],
      "properties": {
        "choice_id": { "$ref": "#/$defs/recordId" },
        "source_wording": { "$ref": "#/$defs/nonemptyString" },
        "target_wording": { "$ref": "#/$defs/nonemptyString" },
        "consequence": { "$ref": "#/$defs/nonemptyString" },
        "canon_support": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonSupport" }
        },
        "canon_gap": { "type": ["string", "null"] }
      }
    },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence"],
      "properties": {
        "result": { "enum": ["pass", "pending", "fail"] },
        "evidence": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence"],
      "properties": {
        "result": { "enum": ["pass", "pending", "fail", "not_applicable"] },
        "evidence": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "superseded_by"],
      "properties": {
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/recordId" } },
        "superseded_by": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/recordId" } }
      }
    }
  }
}
