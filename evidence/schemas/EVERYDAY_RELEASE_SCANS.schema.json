{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/navier-stokes-proof-everyday-english/blob/main/evidence/schemas/EVERYDAY_RELEASE_SCANS.schema.json",
  "title": "Everyday English release text scans",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generated_at",
    "scopes",
    "disallowed_token",
    "authorial_we",
    "local_path_leaks",
    "files"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "passCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "matches"],
      "properties": {
        "status": {"const": "pass"},
        "matches": {"const": 0}
      }
    }
  },
  "properties": {
    "schema": {"const": "navier-stokes-everyday-release-scans/v1"},
    "status": {"const": "pass"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_manuscript", "public_release_text", "path_leak_text"],
      "properties": {
        "target_manuscript": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "public_release_text": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "path_leak_text": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "disallowed_token": {"$ref": "#/$defs/passCount"},
    "authorial_we": {"$ref": "#/$defs/passCount"},
    "local_path_leaks": {"$ref": "#/$defs/passCount"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "scans"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "scans": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["disallowed_token", "authorial_we", "local_path_leaks"]
            }
          }
        }
      }
    }
  }
}
